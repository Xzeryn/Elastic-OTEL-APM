# =============================================================================
# PROCUREMENT FRONTEND - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values before building.
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your values
#   docker build -t procurement-frontend .
#
# Note: These values are baked into the build at compile time.
# =============================================================================

# Browser telemetry is sent to /otlp/ on the app's own origin and forwarded by
# nginx to the EDOT Collector, which holds the Elastic credentials. No Elastic
# URL or key belongs in this file.

# Optional: an API origin different from the page origin that should also
# receive traceparent headers. Same-origin /api calls are traced automatically.
REACT_APP_API_DOMAIN=https://your-domain.com
